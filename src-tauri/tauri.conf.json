{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PuirkleUninstaller",
  "version": "0.4.1",
  "identifier": "com.puirkle.uninstaller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PuirkleUninstaller",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Puirkle",
    "copyright": "Copyright (c) 2026 Puirkle. MIT License.",
    "shortDescription": "Uninstaller with forced removal, leftover detection and rollback",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
